# Copy to .env and adjust (TDD §12.3). Business parameters live in Settings, not here.
DATABASE_URL=postgres://bookstore:bookstore@127.0.0.1:5432/bookstore
APP_ORIGIN=http://localhost:5173
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
PORT=3000
LOG_LEVEL=info
# GHN carrier (TDD §8.2). Leave empty to use the mock carrier; GHN_ENV=sandbox|live.
GHN_TOKEN=
GHN_SHOP_ID=
GHN_ENV=sandbox
# Optional: webhook URL token (/webhooks/ghn?token=...); without it the 3-minute poll is used.
GHN_WEBHOOK_SECRET=
