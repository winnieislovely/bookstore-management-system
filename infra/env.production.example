# /etc/bookstore/.env on the VPS (TDD §12.3). Readable by root only. Never commit real values.
APP_VERSION=
SITE_DOMAIN=
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=
POSTGRES_DB=bookstore
# 32 random bytes, base64.
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=info
# S3-compatible storage in Vietnam (backups).
S3_ENDPOINT=
S3_REGION=
S3_BACKUP_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Encrypts pgBackRest backups and the weekly dump; keep a copy outside the VPS.
BACKUP_CIPHER_PASS=
# Host folder on a second disk for the weekly logical copy.
DUMP_HOST_DIR=/srv/bookstore-dumps
