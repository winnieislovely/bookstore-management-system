# Edge proxy (TDD §3.5, §12.2): TLS, compression, API routing, staff app static files.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api/* /pos/v1/* /webhooks/* /healthz
	handle @backend {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/staff
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Everything outside the hashed assets is revalidated, including deep links such as /dashboard
		# that fall back to index.html: a cached old shell would load assets a new release removed.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
